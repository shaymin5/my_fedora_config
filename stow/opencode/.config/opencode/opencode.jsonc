{
  "plugin": ["oh-my-openagent@latest"],
  "$schema": "https://opencode.ai/config.json",
"permission": {
    "bash": {
            "python *":"deny",
            "python3 *": "deny",
            "pip *":"deny",
            "pip3 *": "deny",
            "rm -rf /":"deny"
        },
    "edit": "deny"
  }
}
