{
  "$schema": "https://opencode.ai/config.json",
  // "plugin": ["@mohak34/opencode-notifier"],
  // "autoupdate": false,
  "permission": {
    "bash": {
      "python *": "deny",
      "python3 *": "deny",
      "pip *": "deny",
      "pip3 *": "deny",
      "rm -rf /": "deny",
    },
    // "edit": "deny"
    "external_directory": {
      "~/.config/opencode/skills/*": "allow",
    },
  },
}
