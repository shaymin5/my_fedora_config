{
  "$schema": "https://opencode.ai/config.json",
  // "plugin": ["oh-my-openagent@disabled"],

  "plugin": ["opencode-notify@lastest"],
"permission": {
    "bash": {
            "python *":"deny",
            "python3 *": "deny",
            "pip *":"deny",
            "pip3 *": "deny",
            "rm -rf /":"deny"
        },
    "edit": "deny"
  }
}
