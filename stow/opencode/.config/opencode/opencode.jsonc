{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "variants": "max",
  // "plugin": ["@mohak34/opencode-notifier"],
  "autoupdate": false,
  "permission": {
    "bash": {
      "*": "allow",
      "python": "deny",
      "python *": "deny",
      "python3": "deny",
      "python3 *": "deny",
      "pip": "deny",
      "pip *": "deny",
      "pip3": "deny",
      "pip3 *": "deny",
      "rm -rf /": "deny",
    },
    // "edit": "deny"
    "external_directory": {
      "~/.config/opencode/skills/*": "allow",
      "/tmp/*": "allow",
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
    },
  },
  "plugins": ["superpowers@git+https://github.com/obra/superpowers.git"],
}
